# Copy values into apps/api/.env for local API startup. Never commit real credentials.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Keep 0 for direct access. Set 1 only when the API is reached through one verified proxy hop.
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://127.0.0.1:3000
DATABASE_URL="sqlserver://localhost:1433;database=hktstore_db;user=YOUR_USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=hktstore-api
JWT_AUDIENCE=hktstore-web
OTP_PEPPER=replace-with-at-least-32-random-bytes
MAIL_MODE=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hktstore.local
## Product images (optional for local API startup; required for real upload smoke test)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_PRODUCT_FOLDER=hktstore/products
PRODUCT_IMAGE_ADAPTER=fake

## Local Admin/Staff seed (development/test only; replace passwords locally)
M3_DEMO_ADMIN_USERNAME=hktstore_admin
M3_DEMO_ADMIN_EMAIL=admin.hktstore@gmail.com
M3_DEMO_ADMIN_PASSWORD=change-me-123
M3_DEMO_STAFF_USERNAME=hktstore_staff
M3_DEMO_STAFF_EMAIL=staff.hktstore@gmail.com
M3_DEMO_STAFF_PASSWORD=change-me-123

## Public website chatbot configuration; the public bot ID is not a secret.
NEXT_PUBLIC_TYPEBOT_ENABLED=false
NEXT_PUBLIC_TYPEBOT_PUBLIC_ID=