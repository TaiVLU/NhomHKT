{
  "name": "@hktstore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src test prisma.config.ts vitest.config.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "auth:seed": "tsx prisma/seed.ts",
    "seed": "tsx src/scripts/seed-demo.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seed:validate": "tsx src/scripts/seed-validate.ts",
    "seed:cleanup-local": "tsx src/scripts/seed-cleanup-local.ts",
    "catalog:cleanup-assets": "tsx src/scripts/cleanup-product-assets.ts",
    "catalog:seed-demo-users": "tsx src/scripts/seed-m3-demo-users.ts",
    "catalog:seed-m5a-demo": "tsx src/scripts/seed-m5a-demo-catalog.ts",
    "catalog:contract-audit": "tsx src/scripts/catalog-contract-audit.ts"
  },
  "dependencies": {
    "@hktstore/shared": "*",
    "@prisma/client": "^6.19.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "file-type": "^22.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}