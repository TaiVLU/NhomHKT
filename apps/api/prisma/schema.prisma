generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                BigInt                @id @default(autoincrement())
  username          String                @unique @db.VarChar(15)
  fullName          String                @db.NVarChar(120)
  email             String                @unique @db.VarChar(254)
  phone             String                @unique @db.VarChar(20)
  passwordHash      String                @db.VarChar(255)
  role              String                @default("CUSTOMER") @db.VarChar(20)
  status            String                @default("ACTIVE") @db.VarChar(20)
  birthday          DateTime?             @db.Date
  gender            String?               @db.VarChar(20)
  cancellationCount Int                   @default(0)
  riskFlag          Boolean               @default(false)
  createdAt         DateTime              @default(now()) @db.DateTime2
  updatedAt         DateTime              @updatedAt @db.DateTime2
  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]
  auditLogs         AuditLog[]
  addresses         Address[]
  carts             Cart[]
  orders            Order[]
  checkoutRequests  CheckoutIdempotency[]
  orderStatusEvents OrderStatusHistory[]  @relation("OrderStatusHistoryChangedBy")
  inventoryLedgers  InventoryLedger[]     @relation("InventoryLedgerActor")
}

model Address {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt
  recipientName String    @db.NVarChar(120)
  phone         String    @db.VarChar(20)
  line1         String    @db.NVarChar(255)
  ward          String    @db.NVarChar(120)
  district      String    @db.NVarChar(120)
  province      String    @db.NVarChar(120)
  postalCode    String?   @db.VarChar(20)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.DateTime2
  updatedAt     DateTime  @updatedAt @db.DateTime2
  deletedAt     DateTime? @db.DateTime2
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders        Order[]   @relation("OrderShippingAddress")

  @@index([userId, deletedAt, isDefault])
  @@index([userId, createdAt])
}

model RefreshToken {
  id                BigInt         @id @default(autoincrement())
  userId            BigInt
  tokenHash         String         @unique @db.Char(64)
  familyId          String         @db.VarChar(64)
  expiresAt         DateTime       @db.DateTime2
  revokedAt         DateTime?      @db.DateTime2
  revocationReason  String?        @db.NVarChar(255)
  replacedByTokenId BigInt?
  createdAt         DateTime       @default(now()) @db.DateTime2
  lastUsedAt        DateTime?      @db.DateTime2
  createdIp         String?        @db.VarChar(45)
  userAgent         String?        @db.NVarChar(500)
  user              User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacedBy        RefreshToken?  @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replaces          RefreshToken[] @relation("TokenRotation")

  @@index([userId, expiresAt, revokedAt])
  @@index([familyId, revokedAt])
}

model PasswordResetOtp {
  id                  BigInt    @id @default(autoincrement())
  userId              BigInt
  otpHash             String    @db.Char(64)
  expiresAt           DateTime  @db.DateTime2
  attemptCount        Int       @default(0)
  verifiedAt          DateTime? @db.DateTime2
  resetTokenHash      String?   @db.Char(64)
  resetTokenExpiresAt DateTime? @db.DateTime2
  consumedAt          DateTime? @db.DateTime2
  createdAt           DateTime  @default(now()) @db.DateTime2
  user                User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, expiresAt, consumedAt])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  actorUserId  BigInt?
  action       String   @db.VarChar(100)
  entityType   String   @db.VarChar(80)
  entityId     String?  @db.VarChar(100)
  metadataJson String?  @db.NVarChar(Max)
  requestId    String?  @db.VarChar(100)
  ip           String?  @db.VarChar(45)
  createdAt    DateTime @default(now()) @db.DateTime2
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model Category {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.NVarChar(120)
  slug            String            @unique @db.VarChar(160)
  description     String?           @db.NVarChar(1000)
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now()) @db.DateTime2
  updatedAt       DateTime          @updatedAt @db.DateTime2
  deletedAt       DateTime?         @db.DateTime2
  products        ProductCategory[]
  primaryProducts Product[]         @relation("ProductPrimaryCategory")

  @@index([isActive, deletedAt, sortOrder, name])
}

model Author {
  id        BigInt          @id @default(autoincrement())
  name      String          @db.NVarChar(160)
  slug      String          @unique @db.VarChar(200)
  bio       String?         @db.NVarChar(Max)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.DateTime2
  updatedAt DateTime        @updatedAt @db.DateTime2
  deletedAt DateTime?       @db.DateTime2
  products  ProductAuthor[]

  @@index([isActive, deletedAt, name])
}

model Publisher {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.NVarChar(160)
  slug        String    @unique @db.VarChar(200)
  description String?   @db.NVarChar(1000)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  deletedAt   DateTime? @db.DateTime2
  products    Product[]

  @@index([isActive, deletedAt, name])
}

model Product {
  id                BigInt            @id @default(autoincrement())
  name              String            @db.NVarChar(255)
  slug              String            @unique @db.VarChar(255)
  shortDescription  String?           @db.NVarChar(1000)
  description       String?           @db.NVarChar(Max)
  releaseDate       DateTime?         @db.Date
  pageCount         Int?
  language          String?           @db.NVarChar(80)
  dimensions        String?           @db.NVarChar(100)
  weightGrams       Int?
  publisherId       BigInt?
  isNew             Boolean           @default(false)
  isFeatured        Boolean           @default(false)
  isActive          Boolean           @default(true)
  publicationState  String            @default("DRAFT") @db.VarChar(20)
  primaryCategoryId BigInt?
  seoTitle          String?           @db.NVarChar(70)
  seoDescription    String?           @db.NVarChar(170)
  createdAt         DateTime          @default(now()) @db.DateTime2
  updatedAt         DateTime          @updatedAt @db.DateTime2
  deletedAt         DateTime?         @db.DateTime2
  publisher         Publisher?        @relation(fields: [publisherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  primaryCategory   Category?         @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variants          ProductVariant[]
  images            ProductImage[]
  categories        ProductCategory[]
  authors           ProductAuthor[]

  @@index([isActive, deletedAt, createdAt])
  @@index([publicationState, deletedAt, createdAt])
  @@index([isFeatured, isActive, createdAt])
  @@index([isNew, isActive, createdAt])
  @@index([publisherId, isActive, createdAt])
  @@index([primaryCategoryId])
}

model ProductVariant {
  id         BigInt         @id @default(autoincrement())
  productId  BigInt
  sku        String         @unique @db.VarChar(64)
  isbn       String?        @db.VarChar(20)
  name       String         @db.NVarChar(120)
  coverType  String?        @db.VarChar(30)
  costPrice  Decimal        @db.Decimal(19, 0)
  listPrice  Decimal        @db.Decimal(19, 0)
  salePrice  Decimal        @db.Decimal(19, 0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @db.DateTime2
  updatedAt  DateTime       @updatedAt @db.DateTime2
  product    Product        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images     ProductImage[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, isActive])
}

model Cart {
  id         BigInt     @id @default(autoincrement())
  customerId BigInt     @unique
  createdAt  DateTime   @default(now()) @db.DateTime2
  updatedAt  DateTime   @updatedAt @db.DateTime2
  customer   User       @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items      CartItem[]

  @@index([customerId, updatedAt])
}

model CartItem {
  id        BigInt         @id @default(autoincrement())
  cartId    BigInt
  variantId BigInt
  quantity  Int
  unitPrice Decimal        @db.Decimal(19, 0)
  createdAt DateTime       @default(now()) @db.DateTime2
  updatedAt DateTime       @updatedAt @db.DateTime2
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cartId, variantId])
  @@index([cartId, updatedAt])
  @@index([variantId])
}

model Order {
  id                        BigInt               @id @default(autoincrement())
  orderNumber               String               @unique @db.VarChar(32)
  customerId                BigInt
  shippingAddressId         BigInt?
  status                    String               @default("PENDING_CONFIRMATION") @db.VarChar(40)
  paymentMethod             String               @default("COD") @db.VarChar(20)
  paymentStatus             String               @default("UNPAID") @db.VarChar(20)
  shippingRecipientName     String               @db.NVarChar(120)
  shippingPhone             String               @db.VarChar(20)
  shippingLine1             String               @db.NVarChar(255)
  shippingWard              String               @db.NVarChar(120)
  shippingDistrict          String               @db.NVarChar(120)
  shippingProvince          String               @db.NVarChar(120)
  shippingPostalCode        String?              @db.VarChar(20)
  deliveryNote              String?              @db.NVarChar(500)
  subtotal                  Decimal              @db.Decimal(19, 0)
  shippingFee               Decimal              @default(0) @db.Decimal(19, 0)
  discount                  Decimal              @default(0) @db.Decimal(19, 0)
  total                     Decimal              @db.Decimal(19, 0)
  grandTotal                Decimal              @default(0) @db.Decimal(19, 0)
  createdAt                 DateTime             @default(now()) @db.DateTime2
  updatedAt                 DateTime             @updatedAt @db.DateTime2
  customer                  User                 @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shippingAddress           Address?             @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                     OrderItem[]
  statusHistory             OrderStatusHistory[]
  checkoutIdempotencyRecord CheckoutIdempotency?

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([shippingAddressId])
}

model OrderStatusHistory {
  id                     BigInt   @id @default(autoincrement())
  orderId                BigInt
  fromStatus             String?  @db.VarChar(40)
  toStatus               String   @db.VarChar(40)
  note                   String?  @db.NVarChar(500)
  changedByUserId        BigInt?
  changedByEmailSnapshot String?  @db.VarChar(254)
  changedByNameSnapshot  String?  @db.NVarChar(120)
  createdAt              DateTime @default(now()) @db.DateTime2
  order                  Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changedBy              User?    @relation("OrderStatusHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId, createdAt])
  @@index([changedByUserId, createdAt])
}

model OrderItem {
  id                          BigInt         @id @default(autoincrement())
  orderId                     BigInt
  variantId                   BigInt
  quantity                    Int
  unitPrice                   Decimal        @db.Decimal(19, 0)
  productTitleSnapshot        String?        @db.NVarChar(255)
  productSlugSnapshot         String?        @db.VarChar(255)
  variantNameSnapshot         String?        @db.NVarChar(120)
  skuSnapshot                 String?        @db.VarChar(64)
  isbnSnapshot                String?        @db.VarChar(20)
  languageSnapshot            String?        @db.NVarChar(80)
  coverImageUrlSnapshot       String?        @db.NVarChar(1000)
  primaryCategoryNameSnapshot String?        @db.NVarChar(120)
  authorNamesSnapshot         String?        @db.NVarChar(Max)
  publisherNameSnapshot       String?        @db.NVarChar(160)
  unitListPrice               Decimal?       @db.Decimal(19, 0)
  unitSalePrice               Decimal?       @db.Decimal(19, 0)
  unitEffectivePrice          Decimal?       @db.Decimal(19, 0)
  lineTotal                   Decimal?       @db.Decimal(19, 0)
  createdAt                   DateTime       @default(now()) @db.DateTime2
  order                       Order          @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant                     ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
  @@index([variantId])
}

model CheckoutIdempotency {
  id          BigInt   @id @default(autoincrement())
  customerId  BigInt
  key         String   @db.VarChar(160)
  requestHash String   @db.Char(64)
  status      String   @default("IN_PROGRESS") @db.VarChar(20)
  orderId     BigInt?  @unique
  createdAt   DateTime @default(now()) @db.DateTime2
  updatedAt   DateTime @updatedAt @db.DateTime2
  customer    User     @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customerId, key])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Inventory {
  productVariantId  BigInt            @id
  onHandQuantity    Int
  reservedQuantity  Int               @default(0)
  lowStockThreshold Int               @default(5)
  createdAt         DateTime          @default(now()) @db.DateTime2
  updatedAt         DateTime          @updatedAt @db.DateTime2
  productVariant    ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledgerEntries     InventoryLedger[]
}

model InventoryLedger {
  id                 BigInt    @id @default(autoincrement())
  inventoryId        BigInt
  adjustmentType     String    @db.VarChar(40)
  quantityDelta      Int
  beforeQuantity     Int
  afterQuantity      Int
  reason             String    @db.NVarChar(500)
  actorUserId        BigInt?
  actorNameSnapshot  String?   @db.NVarChar(120)
  actorEmailSnapshot String?   @db.VarChar(254)
  createdAt          DateTime  @default(now()) @db.DateTime2
  inventory          Inventory @relation(fields: [inventoryId], references: [productVariantId], onDelete: NoAction, onUpdate: NoAction)
  actor              User?     @relation("InventoryLedgerActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([inventoryId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([adjustmentType, createdAt])
}

model ProductCategory {
  productId  BigInt
  categoryId BigInt
  product    Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ProductAuthor {
  productId BigInt
  authorId  BigInt
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author    Author  @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([productId, authorId])
  @@index([authorId, productId])
}

model ProductImage {
  id               BigInt          @id @default(autoincrement())
  productId        BigInt
  productVariantId BigInt?
  url              String          @db.NVarChar(1000)
  publicId         String          @unique @db.NVarChar(255)
  mimeType         String          @db.VarChar(30)
  sizeBytes        Int
  altText          String          @db.NVarChar(255)
  sortOrder        Int             @default(0)
  isPrimary        Boolean         @default(false)
  createdAt        DateTime        @default(now()) @db.DateTime2
  updatedAt        DateTime        @updatedAt @db.DateTime2
  product          Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId, sortOrder])
  @@index([productVariantId, sortOrder])
}

model SlugReservation {
  id           BigInt   @id @default(autoincrement())
  resourceType String   @db.VarChar(40)
  slug         String   @db.VarChar(255)
  resourceId   BigInt
  createdAt    DateTime @default(now()) @db.DateTime2

  @@unique([resourceType, slug])
  @@index([resourceType, resourceId])
}
